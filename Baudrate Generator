module baudrate_generator#(
       parameter integer clk_freq=50_000_000,
       parameter integer baud_rate=9600,
       parameter integer oversampling=16
) (input clk,output tx_enb, rx_enb);
  
  parameter integer TX=clk_freq/baud_rate;
  parameter integer RX=clk_freq/(baud_rate*16);

  reg [12:0]tx_counter;
  reg[9:0]rx_counter;

initial begin
    tx_counter = 0;
    rx_counter = 0;
  end

  always@(posedge clk) begin
    if(tx_counter==TX)
     tx_counter=0;
    else 
      tx_counter=tx_counter+1'b1;
  end
    
    always@(posedge clk) begin
      if (rx_counter==RX)
              rx_counter=0;
      else 
    rx_counter= rx_counter+1'b1;
      
    end
  assign tx_enb=(tx_counter==0)?1'b1:1'b0;
  assign rx_enb=(rx_counter==0)?1'b1:1'b0;
  
endmodule
    
