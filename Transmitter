module uart_tx (input clk,wr_enb,enb,rst,
                input [7:0]data_in,
                output reg tx, 
                output busy);
  
   parameter  idle_state = 2'b00;
   parameter  start_state =2'b01;
   parameter  data_state =2'b10;
   parameter  stop_state =2'b11;

  reg[7:0]data_reg;
  reg[2:0]index;
  reg[1:0]state = idle_state;
 
  always@(posedge clk) begin
   
    if(rst)begin
      tx<=1'b1;
      state<=idle_state;
      data_reg<=8'h0;
      index <=3'b000;
    end
    else begin
      case(state) 
        
        idle_state:begin
          if(wr_enb)begin
          state<=start_state;
          data_reg<=data_in;
          index = 3'b000;
        end
        else state <= idle_state;
    end
         
        start_state:begin
          if(enb)begin
            tx=1'b0;
            state<=data_state;
        end
        
        else
          state <= start_state;
    end
        
        data_state:begin
          if(index==3'b111)begin
          state<=stop_state;
        end
        
        else 
         index = index+3'b001;
          tx<=data_reg[index];
        end
        
        stop_state:begin
          if(enb)begin
           tx=1'b1;
          state<=idle_state;
        end
          else
            state<=stop_state;
        end
      endcase
  end 
  end


  assign busy=(state!=idle_state);
endmodule
